{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "seed": "ts-node --transpile-only src/seed.ts",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm run build",
    "test": "node -r dotenv/config node_modules/vitest/vitest.mjs run",
    "test:watch": "node -r dotenv/config node_modules/vitest/vitest.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/winston": "^2.4.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "react-router-dom": "^7.13.0",
    "sanitize-html": "^2.17.1",
    "sharp": "^0.34.5",
