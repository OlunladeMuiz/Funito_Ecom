# Example environment variables for Funito_Ecom backend
# Copy this file to .env and fill in your real values

DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"
PORT=4000
JWT_ACCESS_SECRET="your-access-secret-32chars-min"
JWT_REFRESH_SECRET="your-refresh-secret-32chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
ADMIN_DEFAULT_PASSWORD="your-admin-password"
SENDGRID_API_KEY="dummy-key"
SENDGRID_VERIFIED_SENDER="dummy@yourdomain.com"
CONTACT_RECEIVER_EMAIL="dummy@yourdomain.com"
